// Only the explicitly selected desktop account may start/stop, including SSH.
// this bounded, unprivileged GNSS diagnostic. No arbitrary unit control.
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") === "g965n-gps-test.service" &&
        (action.lookup("verb") === "start" || action.lookup("verb") === "stop") &&
        subject.user === "@DESKTOP_USER@") {
        return polkit.Result.YES;
    }
});
