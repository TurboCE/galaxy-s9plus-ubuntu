[Unit]
Description=SM-G965N guarded standard rumble and real motor supply
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /usr/local/lib/g965n-haptic-trial/haptic-control.py start --confirm-sm-g965n-backed-up-haptic-trial
ExecStop=/usr/bin/python3 /usr/local/lib/g965n-haptic-trial/haptic-control.py stop --confirm-sm-g965n-backed-up-haptic-trial
TimeoutStartSec=60
TimeoutStopSec=60
UMask=0077

[Install]
WantedBy=multi-user.target
