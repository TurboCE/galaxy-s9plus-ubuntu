+/* SM-G965N low-current board trial. No PMIC-parent or charger reprobe. */
+static const struct property_entry g965n_red[] = {
+	PROPERTY_ENTRY_U32("reg", 1),
+	PROPERTY_ENTRY_U32("color", LED_COLOR_ID_RED),
+	PROPERTY_ENTRY_STRING("function", LED_FUNCTION_INDICATOR), { }
+};
+static const struct property_entry g965n_green[] = {
+	PROPERTY_ENTRY_U32("reg", 2),
+	PROPERTY_ENTRY_U32("color", LED_COLOR_ID_GREEN),
+	PROPERTY_ENTRY_STRING("function", LED_FUNCTION_INDICATOR), { }
+};
+static const struct property_entry g965n_blue[] = {
+	PROPERTY_ENTRY_U32("reg", 3),
+	PROPERTY_ENTRY_U32("color", LED_COLOR_ID_BLUE),
+	PROPERTY_ENTRY_STRING("function", LED_FUNCTION_INDICATOR), { }
+};
+static const struct software_node g965n_nodes[] = {
+	{ .name = "g965n-rgb-low-current" },
+	{ .name = "red", .parent = &g965n_nodes[0], .properties = g965n_red },
+	{ .name = "green", .parent = &g965n_nodes[0], .properties = g965n_green },
+	{ .name = "blue", .parent = &g965n_nodes[0], .properties = g965n_blue },
+	{ }
+};
+static const struct software_node * const g965n_node_group[] = {
+	&g965n_nodes[0], &g965n_nodes[1], &g965n_nodes[2], &g965n_nodes[3], NULL
+};
+static void g965n_remove_nodes(void *data)
+{
+	device_remove_software_node(data);
+	software_node_unregister_node_group(g965n_node_group);
+}
+static int g965n_attach_nodes(struct device *dev)
+{
+	int ret;
+
+	/* Only the existing unbound child of the reviewed PMIC is accepted. */
+	if (dev_fwnode(dev) || strcmp(dev_name(dev), "max77705-rgb"))
+		return -EINVAL;
+	ret = software_node_register_node_group(g965n_node_group);
+	if (ret)
+		return ret;
+	ret = device_add_software_node(dev, &g965n_nodes[0]);
+	if (ret) {
+		software_node_unregister_node_group(g965n_node_group);
+		return ret;
+	}
+	return devm_add_action_or_reset(dev, g965n_remove_nodes, dev);
+}
+
+/* Read only the documented LED bank; never dump PMIC IRQ/status registers. */
+static ssize_t g965n_led_registers_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	struct regmap *map = dev_get_drvdata(dev);
+	unsigned int enable, red, green, blue;
+	int ret;
+
+	ret = regmap_read(map, MAX77705_RGBLED_REG_LEDEN, &enable);
+	if (ret)
+		return ret;
+	ret = regmap_read(map, MAX77705_LED_REG_BRIGHTNESS(1), &red);
+	if (ret)
+		return ret;
+	ret = regmap_read(map, MAX77705_LED_REG_BRIGHTNESS(2), &green);
+	if (ret)
+		return ret;
+	ret = regmap_read(map, MAX77705_LED_REG_BRIGHTNESS(3), &blue);
+	if (ret)
+		return ret;
+	return sysfs_emit(buf, "enable=%02x red=%u green=%u blue=%u\n",
+			enable, red, green, blue);
+}
+static DEVICE_ATTR_RO(g965n_led_registers);
+static struct attribute *g965n_led_attrs[] = {
+	&dev_attr_g965n_led_registers.attr, NULL
+};
+static const struct attribute_group g965n_led_group = { .attrs = g965n_led_attrs };
