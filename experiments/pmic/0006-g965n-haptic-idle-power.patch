--- a/drivers/input/misc/max77693-haptic.c
+++ b/drivers/input/misc/max77693-haptic.c
@@ -61,0 +62,2 @@
+	bool motor_powered;
+	bool motor_bias;
@@ -176,0 +179,48 @@
+}
+
+/* MAX77705 clients may keep evdev open indefinitely. Power only while playing. */
+static int g965n_haptic_power_on(struct max77693_haptic *haptic)
+{
+ int error;
+ if (haptic->motor_powered)
+  return 0;
+ error = max77843_haptic_bias(haptic, true);
+ if (error)
+  return error;
+ haptic->motor_bias = true;
+ error = regulator_enable(haptic->motor_reg);
+ if (error) {
+  if (!max77843_haptic_bias(haptic, false))
+   haptic->motor_bias = false;
+  return error;
+ }
+ haptic->motor_powered = true;
+ return 0;
+}
+
+static void g965n_haptic_power_off(struct max77693_haptic *haptic)
+{
+ int error;
+ if (haptic->motor_powered) {
+  error = regulator_disable(haptic->motor_reg);
+  if (error)
+   dev_err(haptic->dev, "failed to disable motor supply: %d\n", error);
+  else
+   haptic->motor_powered = false;
+ }
+ if (haptic->motor_bias) {
+  error = max77843_haptic_bias(haptic, false);
+  if (error)
+   dev_err(haptic->dev, "failed to disable motor bias: %d\n", error);
+  else
+   haptic->motor_bias = false;
+ }
+}
+
+/* Clear firmware-retained motor/bias state before exposing the input device. */
+static int g965n_haptic_idle_init(struct max77693_haptic *haptic)
+{
+ int error = max77693_haptic_configure(haptic, false);
+ if (error)
+  return error;
+ return max77843_haptic_bias(haptic, false);
@@ -186,0 +237,8 @@
+	if (haptic->dev_type == TYPE_MAX77705) {
+		error = g965n_haptic_power_on(haptic);
+		if (error) {
+			dev_err(haptic->dev, "failed to power motor: %d\n", error);
+			return;
+		}
+	}
+
@@ -195 +253 @@
-		return;
+		goto err_power;
@@ -213,0 +272,3 @@
+err_power:
+	if (haptic->dev_type == TYPE_MAX77705)
+		g965n_haptic_power_off(haptic);
@@ -218,0 +280,11 @@
+
+	if (haptic->dev_type == TYPE_MAX77705) {
+		if (haptic->enabled) {
+			/* Even a failed PMIC write must not leave the real supply on. */
+			max77693_haptic_configure(haptic, false);
+			pwm_disable(haptic->pwm_dev);
+			haptic->enabled = false;
+		}
+		g965n_haptic_power_off(haptic);
+		return;
+	}
@@ -286,0 +359,3 @@
+	if (haptic->dev_type == TYPE_MAX77705)
+		return 0;
+
@@ -311,0 +387,3 @@
+	if (haptic->dev_type == TYPE_MAX77705)
+		return;
+
@@ -366,0 +445,6 @@
