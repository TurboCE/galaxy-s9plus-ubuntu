#!/usr/bin/python3
# SPDX-License-Identifier: GPL-2.0-only
"""Retry saved auto-connect Wi-Fi profiles after two disconnected checks."""
import os
import subprocess
import time


def nmcli(*args):
    return subprocess.run(["nmcli", *args], check=True, capture_output=True,
                          text=True, timeout=25,
                          env=dict(os.environ, LC_ALL="C")).stdout.strip()


class Guard:
    def __init__(self, run=nmcli):
        self.run = run
        self.down = {}

    def retry_allowed(self, name):
        rows = self.run("-t", "-f", "GENERAL.STATE,GENERAL.AUTOCONNECT",
                        "device", "show", name).splitlines()
        fields = dict(row.split(":", 1) for row in rows if ":" in row)
        state = fields.get("GENERAL.STATE", "").split()
        # 30 = disconnected, 120 = failed. Respect a user disconnect and
        # leave devices with an ongoing activation alone.
        return (fields.get("GENERAL.AUTOCONNECT") == "yes"
                and bool(state) and state[0] in ("30", "120"))

    def step(self):
        if self.run("-t", "radio", "wifi") != "enabled":
            self.down.clear()
            return
        devices = []
        for row in self.run("-t", "-f", "DEVICE,TYPE", "device", "status").splitlines():
            name, _, kind = row.rpartition(":")
            if kind == "wifi":
                devices.append(name)
        self.down = {name: n for name, n in self.down.items() if name in devices}
        for name in devices:
            if not self.retry_allowed(name):
                self.down.pop(name, None)
                continue
            self.down[name] = self.down.get(name, 0) + 1
            if self.down[name] < 2:
                continue
            self.down[name] = 0
            profiles = []
            rows = self.run("-t", "-f", "UUID,TYPE,TIMESTAMP", "connection", "show")
            for row in rows.splitlines():
                fields = row.split(":")
                if len(fields) == 3 and fields[1] == "802-11-wireless":
                    profiles.append((int(fields[2] or "0"), fields[0]))
            for _, uuid in sorted(profiles, reverse=True):
                if self.run("-g", "connection.autoconnect", "connection", "show", "uuid", uuid) != "yes":
                    continue
                mode = self.run("-g", "802-11-wireless.mode", "connection", "show", "uuid", uuid)
                if mode not in ("", "infrastructure"):
                    continue
                if not self.retry_allowed(name):
                    break
                print(name + ": retrying saved auto-connect Wi-Fi", flush=True)
                self.run("--wait", "20", "connection", "up", "uuid", uuid, "ifname", name)
                break


def main():
    guard = Guard()
    while True:
        time.sleep(30)
        try:
            guard.step()
        except (subprocess.SubprocessError, ValueError, IndexError) as error:
            # A stopped/restarting NetworkManager must not kill the guard.
            print("Wi-Fi guard retry deferred: " + type(error).__name__, flush=True)


if __name__ == "__main__":
    main()
